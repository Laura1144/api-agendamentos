generator cliente {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Cliente {
  id       String @id @default(uuid()) @db.Char(36)
  nome     String @db.VarChar(100)
  email    String @unique @db.VarChar(150)
  telefone String @db.VarChar(20)

  agendas Agenda[]
}

model Profissional {
  id    String @id @default(uuid()) @db.Char(36)
  nome  String @db.VarChar(100)
  email String @unique @db.VarChar(150)

  agendas Agenda[]
}

model Servico {
  id        String  @id @default(uuid()) @db.Char(36)
  nome      String  @unique @db.VarChar(100)
  descricao String  @db.VarChar(255)
  valor     Decimal @db.Decimal(10, 2)

  agendas Agenda[]
}

model Agenda {
  id     String   @id @default(uuid()) @db.Char(36)
  data   DateTime
  status String   @default("agendado") @db.VarChar(20)
  valor  Decimal  @db.Decimal(10, 2)

  servicoId      String @db.Char(36)
  profissionalId String @db.Char(36)
  clienteId      String @db.Char(36)

  servico      Servico      @relation(fields: [servicoId], references: [id], onDelete: Restrict)
  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: Restrict)
  cliente      Cliente      @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  @@index([profissionalId, data])
}
