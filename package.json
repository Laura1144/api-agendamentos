{
  "name": "api-agendamentos",
  "version": "2.0.0",
  "description": "API REST para agendamento de serviços (clientes, profissionais, serviços e agendamentos)",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "test": "vitest run",
    "test:unit": "vitest run -t unit",
    "test:integration": "vitest run -t integra",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "vercel-build": "prisma generate && tsc -p tsconfig.build.json"
  },
  "keywords": [
    "api",
    "rest",
    "express",
    "typescript",
    "prisma",
    "agendamentos"
  ],
  "author": "Laura Rosa",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.7",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "mariadb": "^3.5.4",
    "prisma": "^7.10.1",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  }
}
