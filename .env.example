# Copie este arquivo para .env e preencha com os seus valores.
# Nunca envie o .env para o repositório.

# Porta da API
PORT=3005

# Usada pela CLI do Prisma (migrations). Caracteres especiais da senha precisam de URL encoding (ex.: @ -> %40).
DATABASE_URL="mysql://mysql:sua_senha@localhost:3308/api-agendamentos"

# Usadas pela aplicação para conectar no banco
DB_HOST=localhost
DB_PORT=3308
DB_USER=mysql
DB_PASSWORD=sua_senha
DB_NAME=api-agendamentos
# true apenas para bancos na nuvem que exigem SSL (deploy)
DB_SSL=false

# Usada só pelo docker-compose para criar o container do MySQL
DB_ROOT_PASSWORD=senha_root
