{
  "openapi": "3.0.3",
  "info": {
    "title": "API Agendamentos",
    "version": "2.0.0",
    "description": "API REST para gerenciar o agendamento de serviços: clientes, profissionais, serviços e agendamentos.\n\nTodos os ids são **UUID**. Erros sempre retornam `{ \"message\": \"...\" }` com o status HTTP correspondente (400 dado inválido, 404 não encontrado, 409 conflito com regra de negócio, 500 erro interno)."
  },
  "servers": [
    {
      "url": "/",
      "description": "Servidor atual"
    }
  ],
  "tags": [
    {
      "name": "Clientes",
      "description": "Pessoas que agendam serviços"
    },
    {
      "name": "Profissionais",
      "description": "Pessoas que prestam os serviços"
    },
    {
      "name": "Serviços",
      "description": "Serviços oferecidos e seus valores"
    },
    {
      "name": "Agendamentos",
      "description": "Agendamento de um serviço por um cliente com um profissional"
    }
  ],
  "paths": {
    "/clientes": {
      "get": {
        "tags": [
          "Clientes"
        ],
        "summary": "Lista todos os clientes",
        "description": "Retorna os clientes em ordem alfabética. Retorna uma lista vazia se não houver nenhum.",
        "responses": {
          "200": {
            "description": "Lista de clientes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Cliente"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "message": "Erro interno do servidor."
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Clientes"
        ],
        "summary": "Cadastra um cliente",
        "description": "Nome, e-mail e telefone são obrigatórios. O e-mail não pode estar em uso por outro cliente.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClienteEntrada"
              },
              "example": {
                "nome": "Maria Silva",
                "email": "maria@email.com",
                "telefone": "(11) 99999-9999"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cliente criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cliente"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "message": "O campo \"email\" deve ser um e-mail válido."
                }
              }
            }
          },
          "409": {
            "description": "E-mail já cadastrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "message": "Já existe um cliente cadastrado com este e-mail."
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "message": "Erro interno do servidor."
                }
              }
            }
          }
        }
      }
    },
    "/clientes/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "UUID do cliente",
          "schema": {
            "type": "string",
            "format": "uuid"
          },
          "example": "3f2b8c1e-9a4d-4e6f-8b2a-1c5d7e9f0a12"
        }
      ],
      "get": {
        "tags": [
          "Clientes"
        ],
        "summary": "Consulta um cliente pelo id",
